{
  "name": "use-selektor",
  "version": "2.0.0",
  "description": "Context selector utilities for React contexts",
  "main": "dist/index.js",
  "licenses": [
    {
      "type": "ISC"
    }
  ],
  "scripts": {
    "build": "tsc --declaration",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danbermantech/use-selektor"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "useSelector",
    "useSelektor",
    "skeletor",
    "hooks",
    "optimization",
    "redux",
    "context",
    "context-selector",
    "useSyncExternalStore"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^2.1.8",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  }
}
